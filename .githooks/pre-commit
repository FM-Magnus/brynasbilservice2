#!/usr/bin/env bash
# Guards for this repository. The legacy client/src/css/index.css freeze was
# removed in Step 7 (2026-09-19), when index.css itself was deleted. What
# remains: Tailwind utilities are allowed only in /admin — public pages style
# themselves through their CSS islands (see docs/CSS_OWNERSHIP.md).

STAGED=$(git diff --cached --name-only)
BLOCKED=0

check_no_growth () {
  local file="$1"
  local reason="$2"
  echo "$STAGED" | grep -qx "$file" || return 0
  git cat-file -e HEAD:"$file" 2>/dev/null || return 0

  local old_lines new_lines
  old_lines=$(git cat-file -p HEAD:"$file" | wc -l | tr -d ' ')
  new_lines=$(git show :"$file" | wc -l | tr -d ' ')

  if [ "$new_lines" -gt "$old_lines" ]; then
    echo ""
    echo "BLOCKED: $file would grow from $old_lines to $new_lines lines."
    echo ""
    echo "$reason"
    echo ""
    echo "If this growth is genuinely intentional, confirm with Magnus, then commit with --no-verify."
    echo ""
    BLOCKED=1
  fi
}

check_max_lines () {
  local file="$1"
  local max="$2"
  local reason="$3"
  echo "$STAGED" | grep -qx "$file" || return 0
  git cat-file -e :"$file" 2>/dev/null || return 0

  local lines
  lines=$(git show :"$file" | wc -l | tr -d ' ')
  if [ "$lines" -gt "$max" ]; then
    echo ""
    echo "BLOCKED: $file has $lines lines (limit $max)."
    echo ""
    echo "$reason"
    echo ""
    BLOCKED=1
  fi
}

# CLAUDE.md and GEMINI.md must stay pure routers to AGENTS.md, the one
# contract for every AI tool. Checked on every commit (not only when the file
# is staged), against the staged version, so deleting or renaming AGENTS.md
# is caught too. Limits are absolute, not "no growth", so they can't ratchet.
check_router () {
  local file="$1"
  local import_line="$2"
  local max="$3"

  if ! git cat-file -e :AGENTS.md 2>/dev/null; then
    echo ""
    echo "BLOCKED: AGENTS.md is missing from the commit. It is the canonical contract that $file routes to."
    echo ""
    BLOCKED=1
    return
  fi

  if ! git cat-file -e :"$file" 2>/dev/null; then
    echo ""
    echo "BLOCKED: $file is missing. It must exist and route to AGENTS.md (first line: $import_line)."
    echo ""
    BLOCKED=1
    return
  fi

  local content first lines
  content=$(git show :"$file")
  first=$(printf '%s\n' "$content" | grep -v '^[[:space:]]*$' | head -n 1)
  lines=$(printf '%s\n' "$content" | wc -l | tr -d ' ')

  if [ "$first" != "$import_line" ]; then
    echo ""
    echo "BLOCKED: $file must start with the line: $import_line"
    echo "(found: $first). That import is what makes the tool load AGENTS.md."
    echo ""
    BLOCKED=1
  fi
  if [ "$lines" -gt "$max" ]; then
    echo ""
    echo "BLOCKED: $file has $lines lines (limit $max). It is a router only —"
    echo "put project rules and facts in AGENTS.md, not here."
    echo ""
    BLOCKED=1
  fi
  if printf '%s\n' "$content" | grep -qE '^##[[:space:]]'; then
    echo ""
    echo "BLOCKED: $file contains a '## ' section. Routers hold no project content;"
    echo "sections belong in AGENTS.md or a docs/ file."
    echo ""
    BLOCKED=1
  fi
}

check_css_layer () {
  echo "$STAGED" | grep -qE '^client/(src/|scripts/check-css\.mjs|package\.json)' || return 0
  command -v node >/dev/null 2>&1 || return 0

  local output
  if ! output=$(node client/scripts/check-css.mjs 2>&1); then
    echo ""
    echo "BLOCKED: the canonical CSS layer check failed."
    echo "$output"
    echo ""
    echo "An unresolved var(--bb-*) does not error at runtime — it silently drops the"
    echo "whole declaration. Define the token in client/src/styles/design-tokens.css,"
    echo "or give the reference a fallback."
    echo ""
    BLOCKED=1
  fi
}

check_no_tailwind_in_public () {
  local violations
  violations=$(git diff --cached -U0 -- 'client/src/pages/*.tsx' 'client/src/components/*.tsx' 'client/src/components/layout/*.tsx' 'client/src/components/ui/*.tsx' ':!client/src/pages/admin/*' ':!client/src/components/admin/*' ':!client/src/components/ThemeSwitcher.tsx' 2>/dev/null | grep '^+.*className=' | grep -E '(^|[[:space:]"])(flex|grid|items-center|justify-between|p-[0-9]|px-[0-9]|py-[0-9]|m-[0-9]|mx-[0-9]|my-[0-9]|text-[a-z]+-[0-9]|bg-[a-z]+-[0-9])([[:space:]"]|$)' || true)

  if [ -n "$violations" ]; then
    echo ""
    echo "BLOCKED: Tailwind utility classes detected in public-facing TSX files."
    echo "Tailwind utilities are permitted ONLY in /admin (see AGENTS.md)."
    echo "Violating line(s):"
    echo "$violations"
    echo ""
    echo "If this change is genuinely intentional, confirm with Magnus, then commit with --no-verify."
    echo ""
    BLOCKED=1
  fi
}

check_no_growth "AGENTS.md" "AGENTS.md is the bounded contract for every AI tool. Replace wording instead of adding; work notes belong in docs/LOG.md, current state in docs/STATUS.md."
check_router "CLAUDE.md" "@AGENTS.md" 12
check_router "GEMINI.md" "@./AGENTS.md" 12
check_max_lines "docs/STATUS.md" 120 "STATUS.md is the current state only. Replace outdated lines instead of adding; history belongs in docs/LOG.md."
check_css_layer
check_no_tailwind_in_public

exit $BLOCKED
