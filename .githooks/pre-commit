#!/usr/bin/env bash
# Guards for this repository. The legacy client/src/css/index.css freeze was
# removed in Step 7 (2026-09-19), when index.css itself was deleted. What
# remains: Tailwind utilities are allowed only in /admin — public pages style
# themselves through their CSS islands (see docs/CSS_OWNERSHIP.md).

STAGED=$(git diff --cached --name-only)
BLOCKED=0

check_no_growth () {
  local file="$1"
  local reason="$2"
  echo "$STAGED" | grep -qx "$file" || return 0
  git cat-file -e HEAD:"$file" 2>/dev/null || return 0

  local old_lines new_lines
  old_lines=$(git cat-file -p HEAD:"$file" | wc -l | tr -d ' ')
  new_lines=$(git show :"$file" | wc -l | tr -d ' ')

  if [ "$new_lines" -gt "$old_lines" ]; then
    echo ""
    echo "BLOCKED: $file would grow from $old_lines to $new_lines lines."
    echo ""
    echo "$reason"
    echo ""
    echo "If this growth is genuinely intentional, confirm with Magnus, then commit with --no-verify."
    echo ""
    BLOCKED=1
  fi
}

check_css_layer () {
  echo "$STAGED" | grep -qE '^client/(src/|scripts/check-css\.mjs|package\.json)' || return 0
  command -v node >/dev/null 2>&1 || return 0

  local output
  if ! output=$(node client/scripts/check-css.mjs 2>&1); then
    echo ""
    echo "BLOCKED: the canonical CSS layer check failed."
    echo "$output"
    echo ""
    echo "An unresolved var(--bb-*) does not error at runtime — it silently drops the"
    echo "whole declaration. Define the token in client/src/styles/design-tokens.css,"
    echo "or give the reference a fallback."
    echo ""
    BLOCKED=1
  fi
}

check_no_tailwind_in_public () {
  local violations
  violations=$(git diff --cached -U0 -- 'client/src/pages/*.tsx' 'client/src/components/*.tsx' 'client/src/components/layout/*.tsx' 'client/src/components/ui/*.tsx' ':!client/src/pages/admin/*' ':!client/src/components/admin/*' ':!client/src/components/ThemeSwitcher.tsx' 2>/dev/null | grep '^+.*className=' | grep -E '(^|[[:space:]"])(flex|grid|items-center|justify-between|p-[0-9]|px-[0-9]|py-[0-9]|m-[0-9]|mx-[0-9]|my-[0-9]|text-[a-z]+-[0-9]|bg-[a-z]+-[0-9])([[:space:]"]|$)' || true)

  if [ -n "$violations" ]; then
    echo ""
    echo "BLOCKED: Tailwind utility classes detected in public-facing TSX files."
    echo "Tailwind utilities are permitted ONLY in /admin (see AGENTS.md)."
    echo "Violating line(s):"
    echo "$violations"
    echo ""
    echo "If this change is genuinely intentional, confirm with Magnus, then commit with --no-verify."
    echo ""
    BLOCKED=1
  fi
}

check_no_growth "AGENTS.md" "AGENTS.md is a bounded startup contract. New work notes belong in docs/SESSION_LOG_CURRENT.md."
check_css_layer
check_no_tailwind_in_public

exit $BLOCKED
