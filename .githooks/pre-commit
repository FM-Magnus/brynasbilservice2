#!/usr/bin/env bash
# Enforces the two files that caused real pain in this project:
# client/src/css/index.css is a frozen legacy dependency layer, and AGENTS.md
# is a bounded startup contract rather than a session log. See
# docs/CSS_OWNERSHIP.md and docs/DESIGN_SYSTEM.md#css-file-organization.

STAGED=$(git diff --cached --name-only)
BLOCKED=0

check_no_growth () {
  local file="$1"
  local reason="$2"
  echo "$STAGED" | grep -qx "$file" || return 0
  git cat-file -e HEAD:"$file" 2>/dev/null || return 0

  local old_lines new_lines
  old_lines=$(git cat-file -p HEAD:"$file" | wc -l | tr -d ' ')
  new_lines=$(git show :"$file" | wc -l | tr -d ' ')

  if [ "$new_lines" -gt "$old_lines" ]; then
    echo ""
    echo "BLOCKED: $file would grow from $old_lines to $new_lines lines."
    echo ""
    echo "$reason"
    echo ""
    echo "If this growth is genuinely intentional, confirm with Magnus, then commit with --no-verify."
    echo ""
    BLOCKED=1
  fi
}

check_frozen () {
  local file="$1"
  local reason="$2"
  echo "$STAGED" | grep -qx "$file" || return 0

  echo ""
  echo "BLOCKED: $file is frozen and has staged changes."
  echo ""
  echo "$reason"
  echo ""
  echo "If this change is genuinely intentional, confirm with Magnus, then commit with --no-verify."
  echo ""
  BLOCKED=1
}

check_frozen "client/src/css/index.css" \
  "Do not add, delete, move, rename, reformat or clean rules in this file.
Existing legacy pages may keep using it unchanged. New or redesigned pages use
an explicitly owned CSS island; see docs/CSS_OWNERSHIP.md."

check_no_growth "AGENTS.md" \
  "AGENTS.md is the mandatory startup contract and must not grow. Replace stale
current-state text with equally concise text when needed. Write dated session
entries to docs/SESSION_LOG_CURRENT.md, not AGENTS.md."

exit $BLOCKED
